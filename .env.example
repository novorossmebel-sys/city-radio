# Скопируй в .env и заполни своими значениями

# Токен Telegram-бота (получить у @BotFather). Бот должен быть админом канала.
TELEGRAM_BOT_TOKEN=

# Токен MAX-бота (получить у @MasterBot: /create). Бот должен быть админом канала.
MAX_BOT_TOKEN=

# Ключ OpenWeather (бесплатный, https://openweathermap.org/api). Без него модуль погоды пропускается.
OPENWEATHER_API_KEY=

# YandexGPT (console.cloud.yandex.ru) — для верификации/рерайта новостей (content/news.py).
# 1. Создай каталог (folder) в Yandex Cloud — его ID и есть YANDEX_FOLDER_ID.
# 2. Включи биллинг в консоли (иначе модель не ответит).
# 3. Создай сервисный аккаунт с ролью ai.languageModels.user → API-ключ → YANDEX_API_KEY.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# Твой личный Telegram chat_id (числовой) — сюда бот шлёт черновики на модерацию (moderation.py).
# Узнать: напиши боту @userinfobot, он пришлёт твой id в ответ.
OWNER_TELEGRAM_CHAT_ID=
