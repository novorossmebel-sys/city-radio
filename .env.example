# Скопируй в .env и заполни своими значениями

# Токен Telegram-бота (получить у @BotFather). Бот должен быть админом канала.
TELEGRAM_BOT_TOKEN=

# Токен MAX-бота (получить у @MasterBot: /create). Бот должен быть админом канала.
MAX_BOT_TOKEN=

# YandexGPT (console.cloud.yandex.ru) — для верификации/рерайта новостей (content/news.py).
# 1. Создай каталог (folder) в Yandex Cloud — его ID и есть YANDEX_FOLDER_ID.
# 2. Включи биллинг в консоли (иначе модель не ответит).
# 3. Создай сервисный аккаунт с ролью ai.languageModels.user → API-ключ → YANDEX_API_KEY.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# Твой личный Telegram chat_id (числовой) — сюда бот шлёт черновики на модерацию (moderation.py).
# Узнать: напиши боту @userinfobot, он пришлёт твой id в ответ.
OWNER_TELEGRAM_CHAT_ID=

# Telethon (MTProto) — чтение чужих Telegram-каналов (novosti_efir, chpnvrsk_official и т.п.)
# отдельным номером-наблюдателем, не ботом. Bot API для этого не годится.
#
# TELETHON_API_ID / TELETHON_API_HASH — НЕОБЯЗАТЕЛЬНЫ. Если оставить пустыми, config.py
# подставит официальные api_id/api_hash самого Telegram Desktop (open-source, значит открыты
# публично) — это в обход my.telegram.org, который на момент написания стабильно выдаёт
# "ERROR" при создании приложения (известный нерешённый баг сервиса). Если однажды захочешь
# свою пару — зарегистрируй на https://my.telegram.org → API development tools → впиши сюда.
TELETHON_API_ID=
TELETHON_API_HASH=
# TELETHON_PHONE — обязателен. Номер аккаунта-наблюдателя в формате +79991234567, им логинимся
# через telethon_login.py.
TELETHON_PHONE=

# VK API — чтение стены открытых пабликов (Палата №6, «Я люблю Новороссийск»).
# Проще всего: создай Standalone-приложение на https://vk.com/apps?act=manage,
# получи токен с правом wall через Implicit Flow (или сервисный ключ доступа приложения —
# для чтения открытой стены общедоступного паблика его обычно достаточно).
VK_API_TOKEN=

# TMDB (themoviedb.org) — настоящие постеры для "Кино и сериалы"/"Что посмотреть" вместо
# YandexART-заглушки. Регистрация → Settings → API → Developer plan (бесплатно, но требует
# честно указать коммерческое использование — иначе предложит платный Commercial plan).
# Нужен только v3 API Key, TMDB_READ_ACCESS_TOKEN (v4) сейчас не используется.
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=
